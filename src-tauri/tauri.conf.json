{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HA Status Updater",
  "version": "1.0.0",
  "identifier": "com.statusupdater.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Home Assistant Status Updater",
        "width": 640,
        "height": 760,
        "minWidth": 520,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Home Assistant Status Updater",
    "longDescription": "Desktop and system tray controller for Home Assistant input_select entities",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
